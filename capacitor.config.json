 {
  "appId": "me.timelessnesses.completionist",
  "appName": "Coworking Calendar",
  "server": {
    "url": "https://coworking-calendar.timelessnesses.me"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true
    },
    "PushNotifications": {
      "presentationOptions": ["banner", "list", "sound"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#488AFF",
      "presentationOptions": ["badge", "sound", "banner"]
    }
  }
}
